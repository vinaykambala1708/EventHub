DB_URL=jdbc:mysql://YOUR_AIVEN_HOST:YOUR_AIVEN_PORT/YOUR_DATABASE?sslMode=REQUIRED
DB_USERNAME=YOUR_AIVEN_USERNAME
DB_PASSWORD=REPLACE_WITH_YOUR_PASSWORD
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES

# Optional first administrator bootstrap. Set BOOTSTRAP_ADMIN=true only for
# the first startup against a database that has no administrator.
BOOTSTRAP_ADMIN=false
APP_BOOTSTRAP_ADMIN_NAME=
APP_BOOTSTRAP_ADMIN_EMAIL=
APP_BOOTSTRAP_ADMIN_PASSWORD=
APP_BOOTSTRAP_ADMIN_PHONE=


# Optional sample catalog owner. This must be an existing account; its role is unchanged.
SAMPLE_EVENT_OWNER_EMAIL=
